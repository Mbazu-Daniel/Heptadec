# Copy to .env and fill in.
#
# Required: BETTER_AUTH_SECRET and HEPTADEC_SECRET_KEY.
# Everything else is optional; commented variables show their default or are
# only needed for the feature they belong to.

# Better Auth (min 32 chars):
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the browser reaches the API (Vite proxies /api on :5173 -> :8787):
BETTER_AUTH_URL=http://localhost:8787
# Cross-origin requests are allowed by the host the request arrived on, so
# moving the web client to another domain or port needs no change here.
# Set this only when the web app is served from a *different* origin than the
# one it calls, e.g. "https://app.example.com,https://admin.example.com".
# HEPTADEC_EXTRA_ORIGINS=

# Social providers — leave blank to disable the provider (its button renders disabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Data source credential encryption (32 bytes, base64):
#   openssl rand -base64 32
HEPTADEC_SECRET_KEY=

# Optional overrides (defaults shown):
# DATABASE_URL=file:./dev.db          # libSQL URL; relative file: paths resolve from the repo root. Use libsql://… for Turso.
# API_PORT=8787
# SCHEDULER_TICK_MS=30000            # how often the scheduler looks for due jobs
# WEB_URL=http://localhost:5173

# Email — invitations and alert delivery. Configure exactly one transport.
# EMAIL_TRANSPORT picks one explicitly; leave it out and whichever credentials
# are set decides. With neither, mail is skipped and the delivery log says so.
# EMAIL_TRANSPORT=resend|cloudflare
# RESEND_API_KEY=
# RESEND_FROM=Heptadec <invite@heptadec.local>
# CLOUDFLARE_ACCOUNT_ID=            # your Cloudflare account: the one the worker
#                                   # deploys into, and where the Email Sending
#                                   # token below lives
# CLOUDFLARE_EMAIL_TOKEN=           # API token with "Email Sending: Edit"
# CLOUDFLARE_EMAIL_FROM=alerts@example.com   # a verified sender on that account
# CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
# Images — a signed upload goes straight from the browser to R2, so the API needs
# the bucket's name and an R2 access key. Create one at Cloudflare -> R2 ->
# Manage R2 -> API Tokens; read and write on the bucket is enough. With no key
# set, image storage reports itself unconfigured and the upload control says so —
# images already in the bucket still read.
#
# The account is the one CLOUDFLARE_ACCOUNT_ID above, which the deploy script
# reads to know where to deploy and the R2 S3 endpoint is built from:
#   https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_BUCKET_NAME=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
#
# Where images are read from. The managed r2.dev subdomain is the bucket's id,
# and its public access must be on for the bucket — in the dashboard, or:
#   cf r2 buckets domains managed update <bucket> --enabled true
# Set R2_CUSTOM_DOMAIN instead for production; it wins over the managed domain,
# which is rate-limited and meant for development. With neither, images are
# proxied through the API instead, which works but costs a request per image.
# R2_PUBLIC_ID=
# R2_CUSTOM_DOMAIN=
# R2_SESSION_TOKEN=                   # only for temporary credentials

# The Worker deployment. These name this project's Cloudflare resources, so
# they are not committed: the Worker configuration is written from them by
# pnpm config:worker, and CI reads the same names as repository secrets.
#
# CLOUDFLARE_ACCOUNT_ID=            # your Cloudflare account
# CLOUDFLARE_D1_DATABASE_ID=        # the D1 database; the deploy script creates
#                                   # it and records the id here
# PUBLIC_URL=                       # the address users open; the Worker's
#                                   # BETTER_AUTH_URL and WEB_URL are this
# RESEND_FROM="Heptadec <noreply@example.com>"

# Billing (optional) — Bachs holds the products and collects the money; this
# app stores only the subscription state its webhooks report.
#
# FILL IN ALL FOUR to turn the paywall on. Anything less and billing reports
# itself unconfigured, so the app stays free and no Subscribe button works.
#
#   BACHS_SECRET_KEY        sk_sandbox_… or sk_live_…  (Bachs -> Developers -> API keys)
#   BACHS_PRODUCT_MONTHLY   prod_…  the product whose interval is month
#   BACHS_PRODUCT_YEARLY    prod_…  the product whose interval is year
#   BACHS_WEBHOOK_SECRET    whsec_… from the webhook endpoint you create, NOT
#                           from the API keys page; it verifies every delivery
#
# Create both products (one per cycle, with a price each) in the Bachs
# dashboard before copying their ids: a product's interval cannot be changed
# after creation, and Bachs charges what its own catalogue says.
#
# These four are what make the product paid: leave them blank and the instance
# is self-hosted — free, and never refused for want of a subscription. Set them
# and every organization on this instance must be inside its trial (seven days
# from when it was created, owned by this app, no card) or subscribed, or it is
# locked out until it pays. Enabling billing later locks out every organization
# older than seven days, not just new ones.
#
# The key must match the host: a sandbox key against the live host is refused,
# and so is a live key against the sandbox.
# BACHS_BASE_URL=https://sandbox-api.bachs.io   # https://api.bachs.io for live
# BACHS_SECRET_KEY=
# BACHS_PRODUCT_MONTHLY=
# BACHS_PRODUCT_YEARLY=
# BACHS_WEBHOOK_SECRET=
