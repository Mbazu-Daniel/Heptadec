# Copy to .env and fill in.

# Better Auth (min 32 chars):
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the browser reaches the API (Vite proxies /api on :5173 -> :8787):
BETTER_AUTH_URL=http://localhost:8787
# Origins allowed to call /api/auth. The browser uses the Vite dev server,
# so :5173 must be trusted even though BETTER_AUTH_URL is :8787.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8787

# Social providers — leave blank to disable the provider (buttons hidden).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional overrides (defaults shown):
# DATABASE_URL=file:./dev.db          # libSQL URL; relative file: paths resolve from the repo root. Use libsql://… for Turso.
# API_PORT=8787