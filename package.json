{
  "name": "heptadec",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm run test:integration",
    "test:integration": "pnpm --filter @heptadec/api run test",
    "compose:up": "docker compose up -d postgres mysql redis",
    "compose:down": "docker compose down",
    "compose:test:up": "docker compose -f docker-compose.test.yml up -d",
    "compose:test:down": "docker compose -f docker-compose.test.yml down",
    "app:up": "docker compose -f docker-compose.app.yml up -d --build",
    "app:down": "docker compose -f docker-compose.app.yml down",
    "seed:test": "./scripts/seed-test.sh",
    "db:generate": "pnpm --filter @heptadec/db run generate",
    "db:migrate": "pnpm --filter @heptadec/db run migrate",
    "deploy:cloudflare": "./scripts/deploy-cloudflare.sh"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
