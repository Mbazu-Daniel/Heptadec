{
  "name": "heptadec",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "build": "pnpm -r run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm run test:integration",
    "test:integration": "pnpm --filter @heptadec/api run test",
    "test:billing": "pnpm --filter @heptadec/api run test:billing",
    "compose:up": "docker compose up -d postgres mysql redis",
    "compose:down": "docker compose down",
    "compose:test:up": "bash scripts/compose-test.sh up -d",
    "compose:test:down": "bash scripts/compose-test.sh down",
    "app:up": "docker compose -f docker-compose.app.yml up -d --build",
    "app:down": "docker compose -f docker-compose.app.yml down",
    "seed:test": "./scripts/seed-test.sh",
    "db:generate": "pnpm --filter @heptadec/db run generate",
    "db:migrate": "pnpm --filter @heptadec/db run migrate",
    "db:migrate:d1": "wrangler d1 migrations apply DB --remote",
    "deploy": "pnpm run build && pnpm run db:migrate:d1 && pnpm run deploy:worker",
    "deploy:cloudflare": "./scripts/deploy-cloudflare.sh",
    "deploy:worker": "wrangler deploy"
  },
  "cloudflare": {
    "label": "Heptadec",
    "products": ["Workers", "D1", "R2"],
    "categories": ["analytics", "developer-tools"],
    "docs_url": "https://github.com/Mbazu-Daniel/Heptadec#cloudflare-workers",
    "bindings": {
      "PUBLIC_URL": {
        "description": "The address users open, for example `https://heptadec.example.com`."
      },
      "BETTER_AUTH_SECRET": {
        "description": "Generate with `openssl rand -base64 32`. Rotating it signs everyone out."
      },
      "HEPTADEC_SECRET_KEY": {
        "description": "Generate with `openssl rand -base64 32`. Rotating it makes every stored data-source credential unreadable."
      }
    }
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
