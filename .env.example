# Copy to .env and fill in.

# Better Auth (min 32 chars):
#   openssl rand -base64 32
BETTER_AUTH_SECRET=
# Where the browser reaches the API (Vite proxies /api on :5173 -> :8787):
BETTER_AUTH_URL=http://localhost:8787
# Cross-origin requests are allowed by the host the request arrived on, so
# moving the web client to another domain or port needs no change here.
# Set this only when the web app is served from a *different* origin than the
# one it calls, e.g. "https://app.example.com,https://admin.example.com".
# HEPTADEC_EXTRA_ORIGINS=

# Social providers — leave blank to disable the provider (its button renders disabled).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Data source credential encryption (32 bytes, base64):
#   openssl rand -base64 32
HEPTADEC_SECRET_KEY=

# Optional overrides (defaults shown):
# DATABASE_URL=file:./dev.db          # libSQL URL; relative file: paths resolve from the repo root. Use libsql://… for Turso.
# API_PORT=8787
# SCHEDULER_TICK_MS=30000            # how often the scheduler looks for due jobs
# WEB_URL=http://localhost:5173

# Email — invitations and alert delivery. Configure exactly one transport.
# EMAIL_TRANSPORT picks one explicitly; leave it out and whichever credentials
# are set decides. With neither, mail is skipped and the delivery log says so.
# EMAIL_TRANSPORT=resend|cloudflare
# RESEND_API_KEY=
# RESEND_FROM=Heptadec <invite@heptadec.local>
# CLOUDFLARE_ACCOUNT_ID=            # account with Email Sending enabled
# CLOUDFLARE_EMAIL_TOKEN=           # API token with "Email Sending: Edit"
# CLOUDFLARE_EMAIL_FROM=alerts@example.com   # a verified sender on that account
# CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4