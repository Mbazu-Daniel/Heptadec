{
  "name": "heptadec",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "__CLOUDFLARE_ACCOUNT_ID__",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heptadec",
      "database_id": "__CLOUDFLARE_D1_DATABASE_ID__",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "__R2_BUCKET_NAME__"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "__CLOUDFLARE_ACCOUNT_ID__",
    "R2_BUCKET_NAME": "__R2_BUCKET_NAME__",
    "R2_PUBLIC_ID": "__R2_PUBLIC_ID__",
    "BETTER_AUTH_URL": "__PUBLIC_URL__",
    "WEB_URL": "__PUBLIC_URL__",
    "RESEND_FROM": "__RESEND_FROM__",
    "BACHS_BASE_URL": "__BACHS_BASE_URL__",
    "BACHS_PRICE_MONTHLY": "__BACHS_PRICE_MONTHLY__",
    "BACHS_PRICE_YEARLY": "__BACHS_PRICE_YEARLY__"
  }
}
