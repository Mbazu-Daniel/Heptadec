{
  "name": "heptadec",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  // The AWS SDK imports node:http for its request handler. Presigning never
  // sends a request, but the import has to resolve in the Worker bundle.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heptadec",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "heptadec-images"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "R2BucketName": "heptadec-images",
    // The bucket's managed public URL. Its subdomain is the bucket id, and
    // public access has to be switched on for the bucket in the dashboard (or
    // `cf r2 buckets domains managed update <bucket> --enabled true`).
    "R2PublicId": "PASTE_YOUR_R2_PUBLIC_ID_HERE",
    "R2CustomDomain": "",
    "CLOUDFLARE_ACCOUNT_ID": "PASTE_YOUR_CLOUDFLARE_ACCOUNT_ID_HERE",
    "BETTER_AUTH_URL": "https://your-worker.your-subdomain.workers.dev",
    "WEB_URL": "https://your-worker.your-subdomain.workers.dev"
  }
}
