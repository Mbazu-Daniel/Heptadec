{
  "name": "heptadec",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heptadec",
      "database_id": "PASTE_YOUR_D1_DATABASE_ID_HERE",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "heptadec-images"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "BETTER_AUTH_URL": "https://your-worker.your-subdomain.workers.dev",
    "WEB_URL": "https://your-worker.your-subdomain.workers.dev"
  }
}
