{
  "name": "heptadec",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-10",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "d3a1a9129ea0d79f4825eee02adbfb31",
  "observability": {
    "enabled": true,
    "traces": { "enabled": true }
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "../web/dist",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "heptadec",
      "database_id": "4eefabbd-e5bc-4823-b18f-83bb563165c7",
      "migrations_dir": "../../packages/db/drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "heptadec-images"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "d3a1a9129ea0d79f4825eee02adbfb31",
    "R2_BUCKET_NAME": "heptadec-images",
    "R2_PUBLIC_ID": "37703147ecbb414dbbf22775b0175ff6",
    "BETTER_AUTH_URL": "https://heptadec.oktopals.com",
    "WEB_URL": "https://heptadec.oktopals.com",
    "RESEND_FROM": "Heptadec <noreply@oktopals.com>"
  }
}
