{
  "name": "@heptadec/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./auth-contracts": "./src/modules/auth/contracts.ts",
    "./data-source-contracts": "./src/modules/data-source/contracts.ts",
    "./sql-quoting": "./src/modules/data-source/sql-quoting.ts",
    "./organization-contracts": "./src/modules/organization/contracts.ts",
    "./member-contracts": "./src/modules/member/contracts.ts",
    "./images-contracts": "./src/modules/images/contracts.ts",
    "./billing-contracts": "./src/modules/billing/contracts.ts",
    "./invitation-contracts": "./src/modules/invitation/contracts.ts",
    "./schema-contracts": "./src/modules/schema/contracts.ts",
    "./query-contracts": "./src/modules/query/contracts.ts",
    "./saved-query-contracts": "./src/modules/saved-query/contracts.ts",
    "./dashboard-contracts": "./src/modules/dashboard/contracts.ts",
    "./scheduler-contracts": "./src/modules/scheduler/contracts.ts",
    "./alert-contracts": "./src/modules/alert/contracts.ts",
    "./notification-contracts": "./src/modules/notification/contracts.ts",
    "./mcp-contracts": "./src/modules/mcp/contracts.ts",
    "./ai-contracts": "./src/modules/ai/contracts.ts",
    "./share-link-contracts": "./src/modules/share-link/contracts.ts",
    "./audit-contracts": "./src/modules/audit/contracts.ts",
    "./http-contracts": "./src/common/http/error-contracts.ts",
    "./rbac": "./src/modules/rbac/permissions.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "test": "vitest run",
    "test:billing": "vitest run --config vitest.billing.config.ts",
    "typecheck": "tsc --noEmit",
    "build:web": "pnpm --filter @heptadec/web build",
    "db:migrate:d1": "wrangler d1 migrations apply heptadec --remote",
    "deploy:web": "pnpm --filter @heptadec/api run build:web",
    "deploy:worker": "pnpm --filter @heptadec/api run build:web && pnpm --filter @heptadec/api exec wrangler deploy"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@aws-sdk/client-s3": "^3.1151.0",
    "@aws-sdk/s3-request-presigner": "^3.1151.0",
    "@better-auth/api-key": "1.7.7",
    "@clickhouse/client-web": "^1.24.0",
    "@heptadec/db": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@libsql/client": "^0.18.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "ai": "^7.0.137",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.12",
    "mongodb": "^6.17.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.16",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "resend": "^4.0.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261009.1",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
